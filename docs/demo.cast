[21.126889, "o", "\r\n\u001b[2m── 1 of 2 ──\u001b[22m\r\n\u001b[1mAkashJana18/miccli\u001b[22m \u001b[2msrc/daemon.rs:22\u001b[22m  \u001b[33munsafe\u001b[39m\r\n\u001b[2m22\u001b[22m \u001b[2m│\u001b[22m     config::log_file_path()\r\n\u001b[2m23\u001b[22m \u001b[2m│\u001b[22m }\r\n\u001b[2m24\u001b[22m \u001b[2m│\u001b[22m \r\n\u001b[2m25\u001b[22m \u001b[2m│\u001b[22m #[cfg(unix)]\r\n\u001b[2m26\u001b[22m \u001b[2m│\u001b[22m fn is_process_alive(pid: i32) -> bool {\r\n\u001b[2m27\u001b[22m \u001b[2m│\u001b[22m     unsafe { libc::kill(pid, 0) == 0 }\r\n\u001b[2m28\u001b[22m \u001b[2m│\u001b[22m }\r\n\u001b[2m29\u001b[22m \u001b[2m│\u001b[22m \r\n\u001b[2m30\u001b[22m \u001b[2m│\u001b[22m #[cfg(not(unix))]\r\n\u001b[2m31\u001b[22m \u001b[2m│\u001b[22m fn is_process_alive(_pid: i32) -> bool {\r\n\u001b[2m32\u001b[22m \u001b[2m│\u001b[22m     false\r\n\r\n"]
[30.323598, "o", "\u001b[1mIn `is_process_alive`, the `unsafe` block assumes that checking if `libc::kill(pid, 0)` equals `0` accurately reflects if the process is alive; what happens if this call returns -1 for reasons other than the process not existing, such as EPERM?\u001b[22m\r\n"]
[30.323668, "o", "\u001b[2m  your answer, blank line to send, :skip or :quit\r\n\u001b[22m\u001b[36m  > \u001b[39m"]
